            "value": "登录时打开"
          }
        }
      }
    },
    "Open in Ghostty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Ghostty 中打开"
          }
        }
      }
    },
    "Open…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开…"
          }
        }
      }
    },
    "Panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴"
          }
        }
      }
    },
    "Pip": {
      "shouldTranslate": false
    },
    "Pip only reads its manifest.json and never runs any file inside. Cards it sends will show where they came from.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 只读它的 manifest.json，不运行里面的任何文件。装上后它发来的卡片会标明来源。"
          }
        }
      }
    },
    "Pip wants to install the firewall (it starts off and blocks nothing).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 要安装防火墙（装完是关着的，什么都不拦）。"
          }
        }
      }
    },
    "Pip wants to keep the firewall on: it stays on, even after a restart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 要保留防火墙：之后一直开着，重启也开着。"
          }
        }
      }
    },
    "Pip wants to turn the firewall off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 要关闭防火墙。"
          }
        }
      }
    },
    "Pip wants to turn the firewall on, starting with a 2-minute trial.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 要开启防火墙，先试运行 2 分钟。"
          }
        }
      }
    },
    "Pip wants to uninstall the firewall: remove its daemon, rules, and files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip 要卸载防火墙：清掉守护进程、规则和文件。"
          }
        }
      }
    },
    "Play Motion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放动作"
          }
        }
      }
    },
    "Plugin Disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件已关闭"
          }
        }
      }
    },
    "Plugins": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件"
          }
        }
      }
    },
    "Pop up an alert card when traffic bypasses the proxy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有流量没走代理时弹红卡"
          }
        }
      }
    },
    "Problem: the check failed (pf stopped, rules replaced, or the tunnel interface is missing); it may not be blocking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "异常：核对没通过（pf 被停、规则被换掉或隧道网卡不在），可能没在拦"
          }
        }
      }
    },
    "Problem: the daemon hasn’t updated its status for 30 seconds, so it’s unclear whether anything is blocked; turn it off or uninstall": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "异常：守护进程 30 秒没有更新状态，说不清在不在拦；关掉或卸载"
          }
        }
      }
    },
    "Protected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保护"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "Quit Pip": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Pip"
          }
        }
      }
    },
    "Quit Pip?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Pip？"
          }
        }
      }
    },
    "Quit Pip…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Pip…"
          }
        }
      }
    },
    "Quitting stops the notch, cards, and the Egress Guard. If the firewall is on, it keeps blocking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后刘海、卡片和出口守卫都会停止。防火墙如果开着，会继续拦截。"
          }
        }
      }
    },
    "Real State": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实状态"
          }
        }
      }
    },
    "Real state: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实状态：%@"
          }
        }
      }
    },
    "Redo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重做"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        }
      }
    },
    "Remove Symlink": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除链接"
          }
        }
      }
    },
    "Removes the daemon, rules, and files and lifts any blocking immediately; use it if you lose your connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉守护进程、规则和文件，开着的话立即放开，断网时也用它"
          }
        }
      }
    },
    "Removes the daemon, rules, and files, and lifts any blocking immediately. Needs an administrator password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清掉守护进程、规则和文件，开着的话立即放开。要管理员密码。"
          }
        }
      }
    },
    "Replace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换"
          }
        }
      }
    },
    "Resident Plugin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻插件"
          }
        }
      }
    },
    "Restore Real State": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复真实状态"
          }
        }
      }
    },
    "Run this in Terminal and a card will pop out of the notch:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端里跑下面这行，刘海会弹一张卡："
          }
        }
      }
    },
    "SF Symbol name, e.g. externaldrive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol 名，例如 externaldrive"
          }
        }
      }
    },
    "Scripts use pipctl to post cards and update activities; run pipctl without arguments for usage. ~/.local/bin must be in your PATH to run pipctl directly (check with echo $PATH in Terminal).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本用 pipctl 发卡片、报活动，pipctl 不带参数看用法。~/.local/bin 要在 PATH 里才能直接敲 pipctl（终端里 echo /Users/ava/.gemini/antigravity/bin:/Users/ava/Library/Application Support/Antigravity/bin:/Users/ava/Library/pnpm/bin:/Users/ava/.bun/bin:/Users/ava/.local/share/mise/installs/bun/1.4.4/bin:/Users/ava/.local/share/mise/installs/go/1.23.12/bin:/Users/ava/.local/share/mise/installs/java/17.0.2/bin:/Users/ava/.local/share/mise/installs/node/26.3.0/bin:/Users/ava/.local/share/mise/installs/npm-sentry-cli/3.5.0/bin:/Users/ava/.local/share/mise/installs/pnpm/11.21.0:/Users/ava/.local/share/mise/installs/python/3.14.3/bin:/Users/ava/.local/share/mise/installs/ruby/4.0.5/bin:/Users/ava/.cargo/bin:/Users/ava/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/pkg/env/global/bin:/Library/Apple/usr/bin:/opt/homebrew/bin:/Users/ava/.foundry/bin:/Users/ava/.local/bin:/Users/ava/.orbstack/bin:/Users/ava/.foundry/bin 看）。"
          }
        }
      }
    },
