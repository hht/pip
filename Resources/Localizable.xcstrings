    "None": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不常驻"
          }
        }
      }
    },
    "Not a valid IPv4 address, or already in the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是有效的 IPv4 地址，或已在列表里。"
          }
        }
      }
    },
    "Not a valid scheme, or already in the list.": {
      "localizations": {
