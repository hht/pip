    "Notch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用"
          }
        }
      }
    },
    "Off, blocking nothing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关着，什么都不拦"
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断网"
          }
        }
      }
    },
    "Offline, can't check the egress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络，暂时检查不了出口"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用"
          }
        }
      }
    },
    "Only changes how Pip and the notch look; doesn’t affect egress decisions, doesn’t pop up alert cards or play sounds. Real alert cards still appear as usual. Nothing is written to disk; restarting the app restores the real state.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改 Pip 和刘海的样子，不影响出口判定，也不弹红卡、不响；真的红卡照常弹出。不写入任何文件，重开 App 即恢复。"
          }
        }
      }
    },
    "Only lowercase letters, digits, and hyphens, up to 32 characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能用小写字母、数字和连字符，至多 32 个字符"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "Open Config File": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开配置文件"
          }
        }
      }
