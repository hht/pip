      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        }
      }
    },
    "命令行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line"
          }
        }
      }
    },
    "命令跑完时弹卡": {
      "localizations": {
        "en": {
