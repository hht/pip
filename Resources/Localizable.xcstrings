          }
        }
      }
    },
    "没走 Clash 隧道的流量除局域网、Clash 直连的地址和国内 IP 外都会被拦下。先试运行 2 分钟：网断了什么都不用做，到时自动关掉；没问题就点「保留」。开启时从 Clash Verge 读一次节点和国内 IP 段，之后换了订阅要关掉再开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic that bypasses the Clash tunnel will be blocked, except for the local network, addresses Clash connects to directly, and mainland China IPs. It starts with a 2-minute trial: if you lose your connection, do nothing and it turns itself off; if all is well, click Keep. It reads the proxy nodes and China IP ranges from Clash Verge once when turned on; after changing subscriptions, turn it off and on again."
          }
        }
      }
    },
    "流量又全部走代理了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All traffic is going through the proxy again"
          }
        }
      }
    },
    "添加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "清掉守护进程、规则和文件，开着的话立即放开。要管理员密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the daemon, rules, and files, and lifts any blocking immediately. Needs an administrator password."
          }
        }
      }
    },
    "清掉守护进程、规则和文件，开着的话立即放开，断网时也用它": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the daemon, rules, and files and lifts any blocking immediately; use it if you lose your connection"
          }
        }
      }
    },
    "点头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod"
          }
        }
      }
    },
    "版本 %@（本机签名）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (signed locally)"
          }
        }
      }
    },
    "状态": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "状态摘要读不出来": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The status summary can’t be read"
          }
        }
      }
    },
    "状态测试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State Test"
          }
        }
      }
    },
    "登录时打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        }
      }
    },
    "看得见的 Pip 各播放一次；开启「减弱动态效果」时只有眨眼。不写入任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every visible Pip plays it once; with Reduce Motion on, only blinking. Nothing is written to disk."
          }
        }
      }
    },
    "真实状态": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real State"
          }
        }
      }
    },
    "真实状态：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real state: %@"
          }
        }
      }
    },
    "眨眼": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blink"
          }
        }
      }
    },
    "眼睛跟着鼠标，身体也往那边转；鼠标移到刘海上时探头。关掉后一直看正前方": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes follow the pointer and the body turns toward it; Pip peeks out when the pointer is on the notch. When off, Pip looks straight ahead"
          }
        }
      }
    },
    "睡着": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asleep"
          }
        }
      }
    },
    "移除 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@"
          }
        }
      }
    },
    "移除链接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Link"
          }
        }
      }
    },
    "空闲": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle"
          }
        }
      }
    },
    "窗口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window"
          }
        }
      }
    },
    "等你回答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Answer"
          }
        }
      }
    },
    "等你批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Approval"
          }
        }
      }
    },
    "等守护进程确认…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the daemon to confirm…"
          }
        }
      }
    },
    "粘贴": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste"
          }
        }
      }
    },
    "系统里没有叫 %@ 的 SF Symbol（名字可以在「SF Symbols」App 里查）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s no SF Symbol named %@ (look up names in the SF Symbols app)"
          }
        }
      }
    },
    "系统里没有这个图标，名字可以在「SF Symbols」App 里查": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No such icon; look up names in the SF Symbols app"
          }
        }
      }
    },
    "红卡一直保留，直到恢复": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Red Card Until Recovered"
          }
        }
      }
    },
    "红卡会撤下，Pip 和面板不再显示出口；后台照常检查，重新打开立即恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The red card goes away and Pip and the panel stop showing the egress. Checks keep running in the background; turn it back on to restore everything right away."
          }
        }
      }
    },
    "终端": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        }
      }
    },
    "给 Claude Code 装上 Pip 自带的 mod：只记录每个回合怎么结束，不记录对话内容。安装会在 ~/.claude/settings.json 里加一项插件，卸载时去掉。已经开着的会话要重开或运行 /reload-plugins 才生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs the mod that ships with Pip into Claude Code. It only records how each turn ended, never the conversation. Installing adds a plugin entry to ~/.claude/settings.json; uninstalling removes it. Sessions already open need a restart or /reload-plugins."
          }
        }
      }
    },
    "编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        }
      }
    },
    "网络正常就点「保留」，之后一直开着，重启也开着": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your connection works, click Keep: it stays on, even after a restart"
          }
        }
      }
    },
    "脚本用 pipctl 发卡片、报活动，pipctl 不带参数看用法。~/.local/bin 要在 PATH 里才能直接敲 pipctl（终端里 echo $PATH 看）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts use pipctl to post cards and report activities; run pipctl with no arguments for usage. ~/.local/bin must be on your PATH to type pipctl directly (check with echo $PATH)."
          }
        }
      }
    },
    "自动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "被打断": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted"
          }
        }
      }
    },
    "装完是关着的，什么都不拦，要用时再打开。要管理员密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s off after installing and blocks nothing; turn it on when you need it. Requires an administrator password."
          }
        }
      }
    },
    "装的是测试规则，只拦去测试地址的流量，不算保护": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test rules are installed: only traffic to the test address is blocked, which isn’t protection"
          }
        }
      }
    },
    "要你看": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs You"
          }
        }
      }
    },
    "规则这一轮没装上，下一轮重做；现在可能没在拦": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules failed to load this round and will be retried; it may not be blocking right now"
          }
        }
      }
    },
    "设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "试运行中，到时自动关掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In trial; turns off automatically when it ends"
          }
        }
      }
    },
    "试运行中，还剩 %lld:%@，到时自动关掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In trial, %lld:%@ left; turns off automatically"
          }
        }
      }
    },
    "试运行到期，正在关掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial ended, turning off"
          }
        }
      }
    },
    "语言": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "超时": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out"
          }
        }
      }
    },
    "跟随鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Pointer"
          }
        }
      }
    },
    "还有流量没走代理，确定关掉提醒？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic is still bypassing the proxy. Turn off alerts anyway?"
          }
        }
      }
    },
    "还没有状态：刚装上或刚卸到一半，稍等几秒；一直这样就卸载重装": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No status yet: just installed or halfway through uninstalling; wait a few seconds. If it stays like this, uninstall and reinstall"
          }
        }
      }
    },
    "这个 id 留给内置插件，换一个": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This id is reserved for a built-in plugin; choose another"
          }
        }
      }
    },
    "这个文件夹就是已经装着的那份": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is the installed copy itself"
          }
        }
      }
    },
    "这个构建不含 mod，要用 scripts/run.sh 打包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build doesn't include the mod; package it with scripts/run.sh"
          }
        }
      }
    },
    "这个构建不含终端插件，要用 scripts/run.sh 打包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build doesn't include the terminal plugin; package it with scripts/run.sh"
          }
        }
      }
    },
    "这个构建不含防火墙，要用 scripts/run.sh 打包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build doesn’t include the firewall; package it with scripts/run.sh"
          }
        }
      }
    },
    "进行中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Progress"
          }
        }
      }
    },
    "退出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "退出 Pip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Pip"
          }
        }
      }
    },
    "退出 Pip…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Pip…"
          }
        }
      }
    },
    "退出 Pip？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Pip?"
          }
        }
      }
    },
    "退出后刘海和卡片都会停止，后台的出口守卫照常运行；要停止守卫，请运行卸载脚本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting stops the notch and cards; the egress guard keeps running in the background. To stop the guard, run the uninstall script."
          }
        }
      }
    },
    "退出码 %d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit code %d"
          }
        }
      }
    },
    "通用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "配置文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Config File"
          }
        }
      }
    },
    "配置文件读不了，暂时不能改设置。修好文件后自动恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config file can't be read, so settings can't be changed for now. They come back once the file is fixed."
          }
        }
      }
    },
    "配置文件读不了，这里显示的是默认值，不是文件里的列表。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config file can't be read, so these are the defaults, not the list in the file."
          }
        }
      }
    },
    "重做": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo"
          }
        }
      }
    },
    "链接到 ~/.local/bin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link into ~/.local/bin"
          }
        }
      }
    },
    "链接白名单": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed Link Schemes"
          }
        }
      }
    },
    "防火墙": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firewall"
          }
        }
      }
    },
    "防火墙守住": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shielded"
          }
        }
      }
    },
    "防火墙状态文件读不出来，现在按关着办；要再开，先卸载再装": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The firewall state file can’t be read, so it’s treated as off; to turn it on again, uninstall and reinstall"
          }
        }
      }
    },
    "隧道网卡": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel Interface"
          }
        }
      }
    },
    "隧道网卡不在（Clash 没开 TUN，或网卡名填错）：现在外网全被拦下": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel interface missing (Clash TUN is off, or the name is wrong): all internet traffic is blocked right now"
          }
        }
      }
    },
    "需要在「系统设置 › 通用 › 登录项」里允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs approval in System Settings › General › Login Items"
          }
        }
      }
    },
    "面板": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel"
          }
        }
      }
    },
    "默认跟随系统；也可以在「语言与地区」里单独给 Pip 选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the system by default. You can also pick one just for Pip in Language & Region"
          }
        }
      }
    },
    "鼠标悬停时展开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand on Hover"
          }
        }
      }
    }
  },
  "version": "1.0"
