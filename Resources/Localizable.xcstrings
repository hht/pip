    "Not installed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装"
          }
        }
      }
    },
    "Not installed: panel displays session state as usual, but completed and error cards will not alert": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装：面板照常显示会话状态，但不弹完成卡和出错卡"
          }
        }
      }
    },
    "Not linked: use the full path below, or link to ~/.local/bin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未链接：用下面的完整路径，或链接到 ~/.local/bin"
