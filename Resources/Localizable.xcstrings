        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眨眼"
          }
        }
      }
    },
    "Can't find claude": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 claude"
          }
        }
      }
    },
    "Can't find the app; it may have been moved. Turn this off and on again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 App，可能被移动过。关掉再打开这个开关即可。"
          }
        }
      }
    },
    "Can't verify the egress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时判断不了出口"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cannot verify installation: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是否已安装：%@"
          }
        }
      }
    },
    "Can’t find Clash Verge’s config folder: turning on reads the proxy nodes and China IP ranges from it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 Clash Verge 的配置目录：开启时要从那里读节点和国内 IP 段"
          }
        }
      }
    },
    "Can’t find claude (checked ~/.local/bin, /opt/homebrew/bin, /usr/local/bin)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 claude（找过 ~/.local/bin、/opt/homebrew/bin、/usr/local/bin）"
          }
        }
      }
    },
    "Can’t keep while there’s a problem: do nothing and it turns off when time’s up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了问题不能保留：什么都不用做，到时自动关掉"
          }
        }
      }
    },
    "Card Duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片停留"
          }
        }
      }
    },
    "Cards are suppressed, and the panel will not show sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不弹卡，面板里也不显示会话"
          }
        }
      }
    },
    "Change Language in System Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中更改语言…"
