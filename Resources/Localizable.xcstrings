            "state": "translated",
            "value": "Change Language in System Settings…"
          }
        }
      }
    },
    "在终端里跑下面这行，刘海会弹一张卡：": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run this in Terminal and a card will pop out of the notch:"
          }
        }
      }
    },
    "在访达中显示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "外部插件 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External plugin · %@"
          }
        }
      }
    },
    "好奇歪看": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curious Tilt"
          }
        }
      }
    },
    "守卫没响应": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guard Not Responding"
          }
        }
      }
    },
    "安装": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        }
      }
