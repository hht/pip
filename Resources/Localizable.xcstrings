    },
    "External plugin - %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部插件 · %@"
          }
        }
      }
    },
    "Eyes track the mouse and the body turns toward it; peeks when the mouse moves onto the notch. When off, Pip always looks forward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛跟着鼠标，身体也往那边转；鼠标移到刘海上时探头。关掉后一直看正前方"
          }
        }
      }
    },
    "Failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败：%@"
